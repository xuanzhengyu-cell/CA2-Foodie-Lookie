<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Document</title>
</head>
<body>
    <%- include ('header/header.ejs') %>

        <!-- Profile Picture -->
    <div class="container mt-4">
        <% if (users.image == "null" || !users.image) { %>
            <img src="/images/nobody.jpg" alt="Profile Picture" class="profile-avatar-lg">
        <% } else { %>
            <img src="/images/<%= users.image %>" alt="Profile Picture" class="profile-avatar-lg">
        <% } %>
        <br>
        <hr>
    
        <!-- User Information -->
        <p>
            <h5>Name:</h5>
            <p><%= users.username %></p>
        </p>
        <p>
            <h5>Details:</h5>
            <p><%= users.details %></p>
        </p>
        <p>
            <h5>Locations Joined:</h5>
            <%= locations.length %>
        </p>
        <hr>

        <!-- User's Locations -->
        <h3>Locations Joined</h3>
        <% if(locations.length === 0) { %>
            <p class="text-muted">This user has not joined any locations yet.</p>
        <% } else { %>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <% locations.forEach(function(location){ %>
                    <div class="location-badge-container">
                        <a href="/location/<%= location.location_id %>" class="btn btn-outline-primary btn-sm rounded-3 px-3 py-2 d-inline-flex align-items-center gap-2">
                            <span><%= location.location_name %></span>
                            <span class="badge <%= location.group_role === 'group_owner' ? 'bg-warning text-dark' : 'bg-secondary text-white' %>" style="font-size: 0.7rem;">
                                <%= location.group_role === 'group_owner' ? 'Owner' : 'Member' %>
                            </span>
                        </a>
                    </div>
                <% }) %>
            </div>
        <% } %>
        <br>
        <a href="/" class="btn btn-dark w-100">
            Back to Home Page
        </a>
        <hr>

        <!-- Comment Button -->
        <a href="/user/<%= user_id %>/comment_create" class="btn btn-primary btn-sm mt-2">Share a Review</a>
        <hr>

        <!-- Comments -->
        <h3>Reviews & Testimonials</h3>
        <% if(comments.length === 0){ %>
            <p>No reviews shared yet.</p>
        <% } else { %>
            <% comments.forEach(function(comment){ %>
                <div>
                    <div class="border rounded p-2 mb-2">
                        <p>
                            <%= comment.comments_text %>
                        </p>
                        <p>
                            <%= comment.date %>
                        </p>
                    </div>
                    <% if (comment.owner_id == user?.user_id || comment.sender_id == user?.user_id || userRoles?.role == "admin") {%>
                        <a href="/user/<%= comment.owner_id %>/comment/edit/<%= comment.comments_id %>" class="btn btn-warning btn-sm">Edit Comment</a>

                        <form action="/user/<%= comment.owner_id %>/comment/delete/<%= comment.comments_id %>" method="POST" class="d-inline">
                            <button class="btn btn-danger btn-sm">
                                Delete Comment
                            </button>
                        </form>
                    <% } %>
                    <hr>
                </div>
            <% }) %>
        <% } %>
        <hr>
    </div>
</body>
</html>