<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Broadcast Stall Update - Flavour Hub</title>
</head>
<body>
    <%- include ('header/header.ejs')%>
    
    <div class="container mt-5">
        <div class="card max-width-form mx-auto border-0 shadow-sm p-4" style="max-width: 600px;">
            <div class="text-center mb-4">
                <h1 class="h2 mb-2">Broadcast Stall Update</h1>
                <p class="text-muted">Post a new announcement, deal, or special item updates for customers visiting this location.</p>
            </div>
            
            <form action="/location/<%= location_id %>/message_create" method="POST">
                <!-- Title Input -->
                <div class="mb-3">
                    <label for="title" class="form-label"><h5>Broadcast Title:</h5></label>
                    <input type="text" id="title" name="title" class="form-control" placeholder="e.g., Today's Lunch Special, 50% Off Dessert" required>
                </div>
                
                <!-- Content Textarea -->
                <div class="mb-4">
                    <label for="content" class="form-label"><h5>Broadcast Content:</h5></label>
                    <textarea id="content" name="content" class="form-control" rows="5" placeholder="Share your menu update, details, or operational changes here..." required></textarea>
                </div>
                
                <!-- Action Buttons -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-warning w-100">Post Broadcast Update</button>
                    <a href="/location/<%= location_id %>" class="btn btn-secondary w-100">Cancel & Exit</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
