<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Admin Pantry Control - Flavour Hub</title>
</head>
<body>
<%- include ('header/header.ejs')%>

    <div class="container mt-4">
        <!-- Title Card -->
        <div class="card mb-4">
            <div class="card-body text-center">
                <h1 class="h2 mb-0">Admin Pantry Control</h1>
            </div>
        </div>

        <!-- Groups Management Card -->
        <div class="card mb-4">
            <div class="card-body">
                <h3 class="h4 mb-2">Location Management</h3>
                <p class="text-muted">Establish new food court locations, assign managers, or review existing gourmet places.</p>
                <a href="/groups" class="btn btn-primary mt-2">
                    See Gourmet Locations
                </a>
            </div>
        </div>

        <!-- Users Management Card -->
        <div class="card mb-4">
            <div class="card-body">
                <h3 class="h4 mb-2">Member Accounts Directory</h3>
                <p class="text-muted">Review credential listings, assign administrative roles, or delete user listings.</p>
                <a href="/users" class="btn btn-primary mt-2">
                    Manage Member Accounts
                </a>
            </div>
        </div>

        <!-- Announcements Card -->
        <div class="card mb-4">
            <div class="card-body">
                <h3 class="h4 mb-3">Create System Broadcast</h3>
                <form action="/announcement" method="post">
                    <textarea id="announcement" class="form-control" name="announcement" rows="5" placeholder="Enter system-wide announcement message here..."><%= announcement.text%></textarea>
                    <br>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Announce</button>
                        <button type="submit" form="clearForm" class="btn btn-danger">Clear Broadcast</button>
                    </div>
                </form>
                <form id="clearForm" action="/clear_announcement" method="post" class="d-none"></form>
            </div>
        </div>
    </div>

</body>
</html>
