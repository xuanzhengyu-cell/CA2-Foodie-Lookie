<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title><%= location_name %> - Flavour Hub</title>
</head>
<body>
    <%- include ('header/header.ejs') %>
    <div class="container mt-4">
        
        <!-- Gourmet Location Page Header -->
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="mb-2"><%= location_name %></h1>
                <p class="text-muted">Explore menu updates, special offers, and broadcasts from stall owners at this location.</p>
            </div>
        </div>

        <div class="row">
            <!-- Sidebar: Actions & Information -->
            <div class="col-md-4 mb-4">
                <div class="card p-3 shadow-sm border-0 bg-white">
                    <h4 class="mb-3">Kitchen Directory</h4>
                    <p class="text-muted small">Manage stalls, browse registered members, or post new updates if you are a stall owner.</p>
                    
                    <div class="d-grid gap-2">
                        <!-- 1. Actions restricted to Admins and Group Owners -->
                        <% if (userRoles?.role === "admin" || userGroupRoles?.group_role === "group_owner") { %>
                            <a href="/location/edit/<%= location_id %>" class="btn btn-warning w-100">
                                Location Control Room
                            </a>
                        <% } %>

                        <!-- 2. Actions visible to all visitors/users -->
                        <a href="/location_members/<%= location_id %>" class="btn btn-dark w-100">
                            View Stalls & Members
                        </a>

                        <!-- 3. Actions for members, owners, and admins -->
                        <% if (userRoles?.role === "admin" || userGroupRoles?.group_role === "group_owner" || userGroupRoles?.group_role === "group_member") { %>
                            <hr class="my-2">
                            <a href="/location/<%= location_id %>/message" class="btn btn-success w-100">
                                Broadcast Stall Update
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Main Panel: Stall Updates (Messages) -->
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="mb-4">Stall Updates & Broadcasts</h3>

                        <% if (messages.length === 0) { %>
                            <div class="alert alert-secondary">
                                No menu updates or specials posted yet. Check back later!
                            </div>
                        <% } else { %>
                            <% messages.forEach(message => { %>
                                <div class="border rounded p-3 mb-3">
                                    <h5 class="fw-bold text-dark"><%= message.title %></h5>
                                    <p class="text-secondary"><%= message.text %></p>
                                    
                                    <% if (message.sender_id == user?.user_id || userRoles?.role == "admin" || userGroupRoles?.group_role == "group_owner") { %>
                                        <div class="mt-3 d-flex gap-2">
                                            <a href="/location/<%= message.location_id %>/message/edit/<%= message.messages_id %>"
                                               class="btn btn-warning btn-sm">
                                                Edit Post
                                            </a>
                                            <form action="/location/<%= message.location_id %>/message/delete/<%= message.messages_id %>"
                                                  method="POST"
                                                  class="d-inline">
                                                <button class="btn btn-danger btn-sm" onclick="return confirm('Delete this update?')">
                                                    Delete Post
                                                </button>
                                            </form>
                                        </div>
                                    <% } %>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
