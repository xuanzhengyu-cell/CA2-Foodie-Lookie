<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Document</title>
</head>
<body>
<%- include ('header/header.ejs') %>
<div class="container mt-4">
    <div>
    <h1 class="mb-3">Manage Member Accounts</h1>
    <p class="text-muted">Perform administrator actions to update user credentials, change roles, or delete accounts.</p>

    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Username & Profile</th>
                    <th>Password Reset</th>
                    <th>Current Role</th>
                    <th>Change Role</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user=> { %>
                    <tr>
                        <td class="ps-4">
                            <form action="/admin/changeName/<%= user.user_id %>" method="POST" class="d-flex flex-column gap-1">
                                <input type="text" id="username" name="username" class="form-control form-control-sm" placeholder="Username" value="<%= user.username %>" required>
                                <div class="d-flex gap-1 mt-1">
                                    <button type="submit" class="btn btn-success btn-sm">Update Name</button>
                                    <a href="/user/<%= user.user_id %>" class="btn btn-outline-primary btn-sm">View Profile</a>
                                </div>
                            </form>
                        </td>

                        <td>
                            <form action="/admin/changePassword/<%= user.user_id %>" method="POST" class="d-flex flex-column gap-1">
                                <input type="password" id="password" name="password" class="form-control form-control-sm" placeholder="New Password" required>
                                <button type="submit" class="btn btn-success btn-sm mt-1">Reset Password</button>
                            </form>
                        </td>

                        <td>
                            <% if (user.role === "admin") { %>
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-3">Admin</span>
                            <% } else if (user.role === "normal_user") {%>
                                <span class="badge bg-secondary text-white px-3 py-2 rounded-3">Normal User</span>
                            <% } else { %>
                                <span class="badge bg-light text-dark px-3 py-2 rounded-3"><%= user.role %></span>
                            <% } %>
                        </td>

                        <td>
                            <form action="/admin/changeRole/<%= user.user_id %>" method="POST" class="d-flex flex-column gap-1">
                                <select name="role" class="form-select form-select-sm">
                                    <option value="admin" <%= user.role ==="admin" ?"selected ":"" %>>
                                        Admin
                                    </option>
                                    <option value="normal_user" <%= user.role==="normal_user" ?"selected ":"" %>>
                                        Normal User
                                    </option>
                                </select>
                                <button type="submit" class="btn btn-success btn-sm mt-1">Save Role</button>
                            </form>
                        </td>
                        
                        <td class="text-end pe-4">
                            <form action="/admin/deleteUser/<%= user.user_id %>" method="POST">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete this user account permanently?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

</body>
</html>