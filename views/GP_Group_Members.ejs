<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Stall Directory - <%= location_name %></title>
</head>
<body>
<%- include ('header/header.ejs') %>
<div class="container mt-4">
    <!-- Page Header -->
    <div class="row mb-4 align-items-center">
        <div class="col-sm-8">
            <h1 class="h2 mb-1">Stall Directory</h1>
            <p class="text-muted mb-0">Browse active stall owners, managers, and registered foodies at <strong><%= location_name %></strong>.</p>
        </div>
        <div class="col-sm-4 text-sm-end mt-3 mt-sm-0">
            <form action="/request/location/<%= location_id %>" method="post" class="d-inline">
                <button type="submit" class="btn btn-success">
                    Join this Location
                </button>
            </form>
        </div>
    </div>

    <!-- Directory Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Vendor / Foodie</th>
                            <th>Role Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users.length === 0) { %>
                            <tr>
                                <td colspan="2" class="text-center py-4 text-muted">
                                    No registered members or stalls at this location yet.
                                </td>
                            </tr>
                        <% } else { %>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td class="ps-4">
                                        <a href="/user/<%= user.user_id %>" class="fw-semibold text-primary text-decoration-none">
                                            <%= user.username %>
                                        </a>
                                    </td>
                                    <td>
                                        <% if (user.group_role === "group_owner") { %>
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-3">Location Manager</span>
                                        <% } else if (user.group_role === "group_member") { %>
                                            <span class="badge bg-primary text-white px-3 py-2 rounded-3">Stall Owner</span>
                                        <% } else if (user.group_role === "normal_user") { %>
                                            <span class="badge bg-secondary text-white px-3 py-2 rounded-3">Foodie</span>
                                        <% } else { %>
                                            <span class="badge bg-light text-dark px-3 py-2 rounded-3">Visitor</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="mt-4">
        <a href="/location/<%= location_id %>" class="btn btn-secondary">
            Back to Location Page
        </a>
    </div>
</div>

</body>
</html>