<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Share a Review - Flavour Hub</title>
</head>
<body>
    <%- include ('header/header.ejs') %>
    
    <div class="container mt-5">
        <div class="card max-width-form mx-auto border-0 shadow-sm p-4" style="max-width: 600px;">
            <div class="text-center mb-4">
                <h1 class="h2 mb-2">Share a Review</h1>
                <p class="text-muted">Leave culinary feedback, recommendations, or review notes for <%= users.username %>.</p>
            </div>
            
            <form action="/user/<%= users.user_id %>/comment_create" method="POST">
                <!-- Content Textarea -->
                <div class="mb-4">
                    <label for="comment" class="form-label"><h5>Your Review:</h5></label>
                    <textarea id="comment" class="form-control" name="comment" rows="5" placeholder="Share your culinary feedback, stall recommendations, or dining experience notes here..." required></textarea>
                </div>
                
                <!-- Action Buttons -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-warning w-100">Submit Review</button>
                    <a href="/user/<%= users.user_id %>" class="btn btn-secondary w-100">Cancel & Exit</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>